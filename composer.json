{
  "name": "solophp/event-dispatcher",
  "type": "library",
  "description": "PSR-14 event dispatcher with listener priorities, subscribers, type-hierarchy matching and optional PSR-3 failure logging",
  "keywords": ["php", "psr-14", "event dispatcher", "events", "listener", "subscriber", "priority"],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com"
    }
  ],
  "homepage": "https://github.com/SoloPHP/Event-Dispatcher",
  "support": {
    "issues": "https://github.com/SoloPHP/Event-Dispatcher/issues",
    "source": "https://github.com/SoloPHP/Event-Dispatcher",
    "docs": "https://solophp.github.io/Event-Dispatcher/"
  },
  "autoload": {
    "psr-4": {
      "Solo\\EventDispatcher\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\EventDispatcher\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.3",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text --coverage-clover build/coverage.xml",
    "analyze": "phpstan analyze",
    "cs": "phpcs --standard=PSR12 src/ tests/",
    "cs-fix": "phpcbf --standard=PSR12 src/ tests/",
    "check": [
      "@cs",
      "@analyze",
      "@test"
    ]
  },
  "provide": {
    "psr/event-dispatcher-implementation": "1.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
